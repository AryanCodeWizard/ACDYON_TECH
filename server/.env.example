# Server Port Configuration
PORT=5005

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/jobflow

# Allowed CORS Origins (comma-separated or *)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Primary Ingestion Target Source RSS URL
SOURCE_URL=https://weworkremotely.com/remote-jobs.rss

# Secondary Fallback Source REST API URL
SECONDARY_SOURCE_URL=https://remotive.com/api/remote-jobs?category=software-dev&limit=20

# Operational Pacing & Resilience Parameters
REQUEST_TIMEOUT_MS=10000
MAX_RETRIES=3
RETRY_DELAY_MS=1000
POLL_INTERVAL_MS=300000